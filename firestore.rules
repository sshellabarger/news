// Deployed via .github/workflows/deploy-rules.yml (auto-runs when this
// file changes; manual runs from the Actions tab).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Public comment threads. Anyone may file a pending comment with only
    // the expected fields; only approved comments are publicly readable.
    // Moderators (docs in /admins) read everything, approve, and delete.
    match /comments/{commentId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
            ['story', 'name', 'text', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.story is string
        && request.resource.data.story.size() >= 1
        && request.resource.data.story.size() <= 80
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'approved'];
      allow delete: if isAdmin();
    }

    // Daily-digest signups. Create-only from the public site; the digest
    // sender reads them with service-account credentials (bypasses rules),
    // and moderators can review or prune from the console.
    match /subscribers/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() <= 254
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Unsubscribe requests, same shape. The digest sender skips any email
    // that appears here, so opting out needs no authentication.
    match /unsubscribes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() <= 254
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Moderator allowlist. Created by hand in the Firebase console
    // (doc id = the moderator's Auth UID); never writable from clients.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
